APP_NAME=Resolva
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
# AI kill-switch: false = rules-only mode (every case goes to manual review)
AI_ENABLED=true
# mock (offline, default) | ollama (local open-weight) | groq (hosted; needs GROQ_API_KEY)
LLM_PROVIDER=mock
# Leave unset for the provider default: qwen2.5:7b-instruct (ollama), llama-3.1-8b-instant (groq)
# LLM_MODEL=
LLM_TIMEOUT_S=8
# propose_v3 (default) adds the stated-time adjustment rules to v2; v2 and v1 kept for comparison
PROMPT_VERSION=propose_v3
CONFIDENCE_THRESHOLD=0.75
RETRIEVAL_TOP_K=4
OLLAMA_BASE_URL=http://localhost:11434
# hashing (offline, default) | ollama (uses OLLAMA_EMBEDDING_MODEL)
EMBEDDING_PROVIDER=hashing
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# GROQ_API_KEY=   (set locally only; never commit)

# Optional read-only attendance demo (provision first; see docs/ATTENDANCE_API.md)
ATTENDANCE_ENABLED=false
# ATTENDANCE_DATABASE_PATH=/absolute/path/to/attendance.sqlite
# ATTENDANCE_CREDENTIALS_PATH=/absolute/path/to/manager-credentials.json
# PostgreSQL store (docker compose --profile postgres up -d postgres). From the api container use
# host 'postgres' instead of 127.0.0.1. Never commit a URL that contains a password.
# ATTENDANCE_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/resolva
